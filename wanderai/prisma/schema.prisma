// WanderAI database schema — kept in sync with lib/types.ts's Destination
// shape. This project's actual data layer (lib/server/repository.ts) uses
// raw SQL via `pg`, not Prisma Client — see README for why (Prisma's
// migration/generate tooling needs a downloaded native binary that this
// project's dev environment couldn't reach). This file documents the
// canonical schema; prisma/schema.sql is the literal SQL applied to the
// database and is kept in sync with it by hand.
//
// Fields that are structured-but-not-independently-managed (quickFacts,
// center coordinates, language guide, weather, best-time calendar,
// shopping guide, safety info, transport options) are stored as Json —
// they don't have their own admin CRUD screens and don't need relational
// querying across destinations. Everything with its own admin CRUD page
// (Attraction, Food, Culture, Hotel, Restaurant, Image, Festival, and the
// history timeline) is a real relational table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  favorites   Favorite[]
  reviews     Review[]
  itineraries Itinerary[]
}

model Destination {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  tagline    String
  region     String
  country    String
  rating     Float    @default(0)
  heroImage  String
  cardImage  String
  tags       String[]
  bestTime   String
  intro      String   @db.Text
  didYouKnow String[]

  quickFacts       Json
  center           Json
  languageGuide    Json
  weather          Json
  bestTimeCalendar Json
  shopping         Json
  safety           Json
  transport        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attractions Attraction[]
  history     HistoricalEvent[]
  food        Food[]
  culture     CultureItem[]
  hotels      Hotel[]
  restaurants Restaurant[]
  festivals   Festival[]
  images      Image[]
  favorites   Favorite[]
  itineraries Itinerary[]
}

model Attraction {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  category      String
  rating        Float
  image         String
  duration      String
  ticket        String
  hours         String
  bestTime      String
  about         String      @db.Text
  architecture  String      @db.Text
  location      String
  lat           Float
  lng           Float

  reviews        Review[]
  itineraryItems ItineraryItem[]
  favorites      Favorite[]

  @@unique([destinationId, slug])
}

model HistoricalEvent {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  year          String
  title         String
  description   String      @db.Text
  order         Int         @default(0)
}

model Food {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  origin        String
  image         String
  description   String      @db.Text
  ingredients   String[]
  taste         String
  significance  String      @db.Text
  whereToTry    String

  @@unique([destinationId, slug])
}

model CultureItem {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title         String
  category      String
  image         String
  description   String      @db.Text

  @@unique([destinationId, slug])
}

model Hotel {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  tier          String
  pricePerNight Int
  rating        Float
  image         String
  lat           Float
  lng           Float

  @@unique([destinationId, slug])
}

model Restaurant {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  cuisine       String
  priceLevel    Int
  rating        Float
  image         String
  lat           Float
  lng           Float

  @@unique([destinationId, slug])
}

model Festival {
  id            String      @id @default(cuid())
  slug          String
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  dateLabel     String
  image         String
  description   String      @db.Text

  @@unique([destinationId, slug])
}

model Image {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  url           String
  category      String
  caption       String
  tall          Boolean     @default(false)
  order         Int         @default(0)
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attractionId String
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  rating       Int
  text         String     @db.Text
  createdAt    DateTime   @default(now())
}

model Favorite {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attractionId  String?
  attraction    Attraction?  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([userId, destinationId, attractionId])
}

model Itinerary {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title         String
  days          Int
  budget        Int
  travelStyle   String
  interests     String[]
  createdAt     DateTime    @default(now())

  items ItineraryItem[]
}

model ItineraryItem {
  id            String      @id @default(cuid())
  itineraryId   String
  itinerary     Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  day           Int
  time          String
  attractionId  String?
  attraction    Attraction? @relation(fields: [attractionId], references: [id])
  label         String
  estimatedCost Int         @default(0)
  order         Int         @default(0)
}
